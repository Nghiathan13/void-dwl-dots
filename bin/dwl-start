#!/bin/sh
export MOZ_ENABLE_WAYLAND=1

export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx

pipewire &
wireplumber &

dwl -s 'dwlb -font "monospace:size=12"' &
until ls "$XDG_RUNTIME_DIR"/dwlb/* >/dev/null 2>&1; do
  sleep 0.1
done
fcitx5 &
dbus-monitor --session "sender='org.fcitx.Fcitx5'" 2>/dev/null | while read -r _; do pkill -USR1 slstatus; done &
slstatus -s | dwlb -status-stdin all
