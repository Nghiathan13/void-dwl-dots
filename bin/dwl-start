#!/bin/sh
export MOZ_ENABLE_WAYLAND=1

export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx

# Session-level audio services: outlive dwl, started before it
pipewire &
wireplumber &

# tag bar via -s (live tag status); rest via autostart[]
exec dwl -s 'dwlb -font "monospace:size=12"'
